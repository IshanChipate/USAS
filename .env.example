# ==============================================================================
# Urban Sustainability Assessment System (USAS) — Environment Variables
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# Authentication & Session Security
# Generate a cryptographically secure key for production token signing:
AUTH_SECRET_KEY=usas-maharashtra-urban-secret-key-2026-auth-token

# 1. Google Gemini API (Optional — for RAG narrative synthesis; offline fallback included)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAQ API (Optional — for real-time station air quality readings)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# 3. MongoDB Atlas (Optional — for scenario archival and audit logging)
MONGODB_URI=
MONGODB_DATABASE=usas

# 4. Frontend API URL (Leave blank in production for unified single-port serving)
VITE_API_URL=
