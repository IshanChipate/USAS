# Urban Sustainability Assessment System (USAS) - Environment Configuration Example

# 1. OpenAQ API (Required for Live Air Quality API only)
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_BASE_URL=https://api.openaq.org/v3

# 2. Google Gemini API (Optional - for advanced LLM synthesis; recommendations work 100% offline)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. MongoDB Configuration (Optional - for persistent scenario storage)
MONGODB_URI=
MONGODB_DB=usas_db
